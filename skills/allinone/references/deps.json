{
  "version": 2,
  "architecture": "vendored",
  "install_order": ["caveman", "ponytail", "superpowers", "taste-skill", "graphify-skill", "graphify-cli", "obsidian"],
  "tiers": {
    "tier1_vendored_plugins": ["caveman", "ponytail", "superpowers", "taste-skill", "graphify"],
    "tier2_external": ["graphify CLI", "obsidian MCP"]
  },
  "dependencies": {
    "caveman": {
      "type": "vendored-plugin",
      "plugin_dir": "plugins/caveman",
      "origin": "juliusbrussee/caveman (MIT; engine/BSL parts excluded)",
      "install": "claude plugin install caveman@allinone",
      "check": "grep '\"caveman@allinone\"' ~/.claude/plugins/installed_plugins.json",
      "purpose": "Terse output mode, 65% token cut"
    },
    "ponytail": {
      "type": "vendored-plugin",
      "plugin_dir": "plugins/ponytail",
      "origin": "dietrichgebert/ponytail (MIT)",
      "install": "claude plugin install ponytail@allinone",
      "check": "grep '\"ponytail@allinone\"' ~/.claude/plugins/installed_plugins.json",
      "purpose": "Lazy minimal-solution ladder"
    },
    "superpowers": {
      "type": "vendored-plugin",
      "plugin_dir": "plugins/superpowers",
      "origin": "obra/superpowers (MIT)",
      "install": "claude plugin install superpowers@allinone",
      "check": "grep '\"superpowers@allinone\"' ~/.claude/plugins/installed_plugins.json",
      "purpose": "Process skills: brainstorming, TDD, debugging"
    },
    "taste-skill": {
      "type": "vendored-plugin",
      "plugin_dir": "plugins/taste-skill",
      "origin": "Leonxlnx/taste-skill (MIT)",
      "install": "claude plugin install taste-skill@allinone",
      "check": "grep '\"taste-skill@allinone\"' ~/.claude/plugins/installed_plugins.json",
      "provides": ["design-taste-frontend", "gpt-taste", "high-end-visual-design", "brandkit", "minimalist-ui", "industrial-brutalist-ui", "stitch-design-taste", "imagegen-frontend-web", "imagegen-frontend-mobile", "image-to-code", "redesign-existing-projects", "full-output-enforcement", "design-taste-frontend-v1"],
      "purpose": "Design taste family for frontend work"
    },
    "graphify": {
      "type": "vendored-plugin + external CLI",
      "plugin_dir": "plugins/graphify",
      "cli_package": "graphifyy",
      "install": "claude plugin install graphify@allinone && pip install --user graphifyy",
      "check": "grep '\"graphify@allinone\"' ~/.claude/plugins/installed_plugins.json && command -v graphify",
      "purpose": "Codebase to knowledge graph, query-first context"
    },
    "obsidian": {
      "type": "mcp-server",
      "server": "obsidian-vault",
      "command": "npx -y @modelcontextprotocol/server-filesystem <vault-path>",
      "install": "claude mcp add obsidian-vault -s user -- npx -y @modelcontextprotocol/server-filesystem <vault-path>",
      "check": "grep obsidian ~/.claude.json",
      "default_vault": "~/MyProject/ChasoulUIX-BRAINSTROMING",
      "purpose": "Vault read/write for notes and documentation"
    }
  }
}
